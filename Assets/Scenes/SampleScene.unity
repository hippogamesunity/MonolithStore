      \u0433\u043E\u0440\u0448\u043E\u043A \u0438 \u043F\u043E\u0434\u0434\u043E\u043D"
    MaterialDescription: "\u0412 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0435.
      \u041A\u0430\u0448\u043F\u043E \u043D\u0435 \u043D\u0430\u043C\u043E\u043A\u043D\u0435\u0442,
      \u0430 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0435 \u043D\u0435 \u0437\u0430\u0441\u043E\u0445\u043D\u0435\u0442."
    TrayTitle: "\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0433\u043E\u0440\u0448\u043E\u043A \u0438 \u043F\u043E\u0434\u0434\u043E\u043D"
    TrayDescription: "\u041F\u0440\u043E\u0434\u0430\u044E\u0442\u0441\u044F \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E
      (\u0430\u0440\u0442. 4882977695). \u041A\u0430\u0448\u043F\u043E \u043D\u0435
      \u043D\u0430\u043C\u043E\u043A\u043D\u0435\u0442, \u0430 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0435
      \u043D\u0435 \u0437\u0430\u0441\u043E\u0445\u043D\u0435\u0442."
    Properties:
    - Text: "\u0413\u0438\u043F\u0441"
      Icon: {fileID: 21300000, guid: 85b1b518ba4a8e74f9b36e4427d611eb, type: 3}
    - Text: "\u0420\u0443\u0447\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430"
      Icon: {fileID: 21300000, guid: edba6b14405242a48a2bcf75edd0fc4a, type: 3}
    - Text: "650 \u043C\u043B"
      Icon: {fileID: 21300000, guid: d1628972da76b244481c5463949c4609, type: 3}
    - Text: "120 x 87 \u043C\u043C"
      Icon: {fileID: 21300000, guid: 028df673f68fc4742bbe06e7875735e3, type: 3}
    Screenshots:
    - Sprite: {fileID: 21300000, guid: fa7d116df3fec8e40a38f3cb2ad86ef8, type: 3}
      Offset: {x: 0, y: -250}
      Scale: 1
      Rotation: 0
    - Sprite: {fileID: 21300000, guid: ec5e4c5fabb41a547a94fc118d4f51b0, type: 3}
      Offset: {x: 0, y: -250}
      Scale: 1
      Rotation: 0
    - Sprite: {fileID: 21300000, guid: 9903cd5a914d6324eb992fe3445fd9b0, type: 3}
