      Scale: 1
      Rotation: 0
    - Sprite: {fileID: 21300000, guid: 6a83e76a5ed7e5044a2c1b2c841419f3, type: 3}
      Offset: {x: 0, y: -200}
      Scale: 1
      Rotation: 0
  - Id: Prism
    Title: Prism
    Description: "\u0410\u0432\u0442\u043E\u0440\u0441\u043A\u043E\u0435 \u043A\u0430\u0448\u043F\u043E
      \u0441 \u043F\u043E\u0434\u0434\u043E\u043D\u043E\u043C"
    Collection: PREMIUM PLANTER
    MaterialTitle: "\u041F\u0440\u0435\u043C\u0438\u0430\u043B\u044C\u043D\u044B\u0439
      \u043F\u043B\u0430\u0441\u0442\u0438\u043A"
    MaterialDescription: "PLA-\u043F\u043B\u0430\u0441\u0442\u0438\u043A \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u044F\u0442
      \u0438\u0437 \u043A\u0443\u043A\u0443\u0440\u0443\u0437\u044B \u0438\u043B\u0438
      \u0441\u0430\u0445\u0430\u0440\u043D\u043E\u0433\u043E \u0442\u0440\u043E\u0441\u0442\u043D\u0438\u043A\u0430"
    TrayTitle: "\u0412\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0439 \u043F\u043E\u0434\u0434\u043E\u043D"
    TrayDescription: "\u0421\u043E\u0431\u0435\u0440\u0435\u0442 \u0438\u0437\u043B\u0438\u0448\u043A\u0438
      \u0432\u043B\u0430\u0433\u0438. \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u0430
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u0444\u0438\u0442\u0438\u043B\u044C\u043D\u043E\u0433\u043E
      \u0430\u0432\u0442\u043E\u043F\u043E\u043B\u0438\u0432\u0430."
    Properties:
    - Text: "PLA-\u043F\u043B\u0430\u0441\u0442\u0438\u043A"
