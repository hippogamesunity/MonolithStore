      Offset: {x: 0, y: 0}
      Scale: 0.9
      Rotation: 0
    - Sprite: {fileID: 21300000, guid: 36bf583eb74f2f84a94d5e6c9c326651, type: 3}
      Offset: {x: 0, y: 0}
      Scale: 0.9
      Rotation: 0
  ItemMetas:
  - Id: Vibes Mini 2430
    Title: "\u0412\u0438\u0431\u0440\u043E\u0441\u0442\u043E\u043B\u0438\u043A \u0434\u043B\u044F
      \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u0442\u0432\u0430 %TITLE%"
    Description: "\u041A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u044B\u0439 \u0432\u0438\u0431\u0440\u043E\u0441\u0442\u043E\u043B\u0438\u043A
      Vibes Mini 2430 \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C 160\u0445160\u044570
      \u043C\u043C \u2014 \u043D\u0435\u0437\u0430\u043C\u0435\u043D\u0438\u043C\u044B\u0439
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442 \u0434\u043B\u044F
      \u043C\u0430\u0441\u0442\u0435\u0440\u043E\u0432, \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0449\u0438\u0445
      \u0441 \u0433\u0438\u043F\u0441\u043E\u043C, \u044D\u043F\u043E\u043A\u0441\u0438\u0434\u043D\u043E\u0439
      \u0441\u043C\u043E\u043B\u043E\u0439, \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u043D\u044B\u043C
      \u0431\u0435\u0442\u043E\u043D\u043E\u043C \u0438 \u0436\u0438\u0434\u043A\u0438\u043C
      \u0441\u0438\u043B\u0438\u043A\u043E\u043D\u043E\u043C. \u041C\u0438\u043D\u0438-\u0432\u0438\u0431\u0440\u043E\u0441\u0442\u043E\u043B
      \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E \u0443\u0434\u0430\u043B\u044F\u0435\u0442
      \u043F\u0443\u0437\u044B\u0440\u044C\u043A\u0438 \u0432\u043E\u0437\u0434\u0443\u0445\u0430
      \u0438\u0437 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0430, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044F
      \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u0443\u044E \u0433\u043B\u0430\u0434\u043A\u043E\u0441\u0442\u044C
      \u0438 \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C \u0433\u043E\u0442\u043E\u0432\u044B\u0445
      \u0438\u0437\u0434\u0435\u043B\u0438\u0439. \u041F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u0434\u043B\u044F \u0437\u0430\u043B\u0438\u0432\u043A\u0438 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0445
      \u043A\u0430\u0448\u043F\u043E, \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u043D\u0438\u043A\u043E\u0432,
      \u0444\u0438\u0433\u0443\u0440\u043E\u043A \u0438 \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u0439.\n\n\u041F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430
      \u043C\u043E\u0434\u0435\u043B\u0438:\n\n\u041D\u0430\u0434\u0435\u0436\u043D\u0430\u044F
      \u0444\u0438\u043A\u0441\u0430\u0446\u0438\u044F: \u0432\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0439
      \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u043C\u044B\u0439 \u0444\u0438\u043A\u0441\u0430\u0442\u043E\u0440
      \u043F\u0440\u043E\u0447\u043D\u043E \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
      \u043C\u043E\u043B\u0434 \u043D\u0430 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435,
      \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0449\u0430\u044F \u0435\u0433\u043E
      \u0441\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u0432\u043E \u0432\u0440\u0435\u043C\u044F
      \u0440\u0430\u0431\u043E\u0442\u044B.\n\n\u0418\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0439
      \u0440\u0430\u0437\u043C\u0435\u0440: \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u044B\u0435
      \u0433\u0430\u0431\u0430\u0440\u0438\u0442\u044B 16\u044516 \u0441\u043C \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442
      \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u0442\u044C \u0440\u0430\u0431\u043E\u0447\u0435\u0435
      \u043C\u0435\u0441\u0442\u043E \u0434\u0430\u0436\u0435 \u043D\u0430 \u043E\u0431\u044B\u0447\u043D\u043E\u043C
      \u0434\u043E\u043C\u0430\u0448\u043D\u0435\u043C \u0441\u0442\u043E\u043B\u0435.\n\n\u042D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u043D\u043E\u0441\u0442\u044C
      \u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C:
      \u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C
      3 \u0412\u0442 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442
      \u043C\u044F\u0433\u043A\u0443\u044E, \u043D\u043E \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0443\u044E
      \u0432\u0438\u0431\u0440\u0430\u0446\u0438\u044E \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0435\u0433\u043E
      \u0448\u0443\u043C\u0430 \u0438 \u044D\u043D\u0435\u0440\u0433\u043E\u043F\u043E\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u0438\u044F.\n\n\u0413\u043E\u0442\u043E\u0432
      \u043A \u0440\u0430\u0431\u043E\u0442\u0435: \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D
      \u043D\u0430 \u0437\u0430\u043B\u0438\u0432\u043A\u0443 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0445
      \u0444\u043E\u0440\u043C \u0441 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u043C
      \u0432\u0435\u0441\u043E\u043C \u0441\u043C\u0435\u0441\u0438 \u0434\u043E
      500 \u0433.\n\n\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438:\n\n\u0420\u0430\u0437\u043C\u0435\u0440\u044B
      \u0438\u0437\u0434\u0435\u043B\u0438\u044F: 160\u0445160\u044570 \u043C\u043C\n\n\u041C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439
      \u0432\u0435\u0441 \u0441\u043C\u0435\u0441\u0438: 500 \u0433\n\n\u041C\u043E\u0449\u043D\u043E\u0441\u0442\u044C:
      3 \u0412\u0442\n\n\u041D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435:
      \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u0435 \u043F\u0443\u0437\u044B\u0440\u044C\u043A\u043E\u0432
      \u0432\u043E\u0437\u0434\u0443\u0445\u0430, \u0443\u043F\u043B\u043E\u0442\u043D\u0435\u043D\u0438\u0435
      \u0441\u043C\u0435\u0441\u0438\n\n\u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0438:
      \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u043C\u044B\u0439 \u0444\u0438\u043A\u0441\u0430\u0442\u043E\u0440
      \u0434\u043B\u044F \u0444\u043E\u0440\u043C (\u043C\u043E\u043B\u0434\u043E\u0432)\n"
