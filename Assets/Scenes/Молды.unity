      Rotation: 0
  ItemMetas:
  - Id: "\u041C\u0443\u043B\u044C\u0442\u0438\u043C\u043E\u043B\u0434 Concept Max"
    Title: "\u041C\u0443\u043B\u044C\u0442\u0438\u043C\u043E\u043B\u0434 %TITLE%
      \u0434\u043B\u044F \u043A\u0430\u0448\u043F\u043E \u0438\u043B\u0438 \u0433\u043E\u0440\u0448\u043A\u0430
      \u0438\u0437 \u0433\u0438\u043F\u0441\u0430"
    Description: "\u0410\u0432\u0442\u043E\u0440\u0441\u043A\u0438\u0439 \u0440\u0430\u0437\u0431\u043E\u0440\u043D\u044B\u0439
      \u043C\u0443\u043B\u044C\u0442\u0438\u043C\u043E\u043B\u0434 %TITLE% \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D
      \u0434\u043B\u044F \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u043A\u0430\u0448\u043F\u043E
      \u0438\u0437 \u0433\u0438\u043F\u0441\u0430. \u0421\u043C\u0435\u043D\u043D\u044B\u0439
      \u0432\u043A\u043B\u0430\u0434\u044B\u0448 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
      \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C \u043A\u0430\u0448\u043F\u043E
      \u0441 \u0440\u0430\u0437\u043D\u044B\u043C\u0438 \u0434\u0438\u0437\u0430\u0439\u043D\u0430\u043C\u0438.
      \u0414\u0438\u0430\u043C\u0435\u0442\u0440 \u043A\u0430\u0448\u043F\u043E -
      120 \u043C\u043C, \u0432\u044B\u0441\u043E\u0442\u0430 - 87 \u043C\u043C. \u0414\u0438\u0430\u043C\u0435\u0442\u0440
      \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0433\u043E \u0441\u0442\u0430\u043A\u0430\u043D\u0430
      - 102 \u043C\u043C \u0441\u0432\u0435\u0440\u0445\u0443 \u0438 100 \u043C\u043C
      \u0441\u043D\u0438\u0437\u0443, \u0432\u044B\u0441\u043E\u0442\u0430 79 \u043C\u043C.
      \u0414\u043B\u044F \u043A\u0430\u0448\u043F\u043E \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0442
      \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0433\u043E\u0440\u0448\u043A\u0438
      \u0434\u0438\u0430\u043C\u0435\u0442\u0440\u043E\u043C 10 \u0441\u043C \u0438
      \u0432\u044B\u0441\u043E\u0442\u043E\u0439 8 \u0441\u043C (0.5 \u043B\u0438\u0442\u0440\u0430,
      \u0430\u0440\u0442\u0438\u043A\u0443\u043B 1209521249).\r\n\r\n\u0427\u0442\u043E
      \u0432\u0430\u0436\u043D\u043E \u0437\u043D\u0430\u0442\u044C \u043F\u0435\u0440\u0435\u0434
      \u043F\u043E\u043A\u0443\u043F\u043A\u043E\u0439:\r\n- \u0433\u043E\u0442\u043E\u0432\u044B\u0435
      \u0438\u0437\u0434\u0435\u043B\u0438\u044F \u0442\u0440\u0435\u0431\u0443\u044E\u0442
      \u0448\u043B\u0438\u0444\u043E\u0432\u043A\u0438, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
      \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u0448\u0432\u0430\r\n- \u0441\u0431\u043E\u0440\u043D\u044B\u0439
      \u043C\u043E\u043B\u0434 \u043D\u0435\u0433\u0435\u0440\u043C\u0435\u0442\u0438\u0447\u043D\u044B\u0439,
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435
      \u043F\u043E\u0434\u0442\u0435\u043A\u0430\u043D\u0438\u044F \u0433\u0438\u043F\u0441\u0430\r\n-
      \u043C\u043E\u043B\u0434 \u043C\u043E\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0431\u0435\u0437 \u0432\u043A\u043B\u0430\u0434\u044B\u0448\u0430, \u0442\u043E\u0433\u0434\u0430
      \u0431\u0443\u0434\u0443\u0442 \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C\u0441\u044F
      \u0440\u043E\u0432\u043D\u044B\u0435 \u0446\u0438\u043B\u0438\u043D\u0434\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u043A\u0430\u0448\u043F\u043E\r\n- \u0446\u0432\u0435\u0442 \u043C\u043E\u043B\u0434\u0430
      \u043C\u043E\u0436\u0435\u0442 \u043E\u0442\u043B\u0438\u0447\u0430\u0442\u044C\u0441\u044F
      \u043E\u0442 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430 \u043D\u0430
      \u0444\u043E\u0442\u043E\r\n- \u0432 \u043D\u0430\u0448\u0435\u043C \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435
      \u043C\u043E\u0436\u043D\u043E \u043A\u0443\u043F\u0438\u0442\u044C \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0432\u043A\u043B\u0430\u0434\u044B\u0448\u0438 \u0441 \u0440\u0430\u0437\u043D\u044B\u043C\u0438
      \u0434\u0438\u0437\u0430\u0439\u043D\u0430\u043C\u0438\r\n- \u0432 \u043D\u0430\u0448\u0435\u043C
      \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435 \u043C\u043E\u0436\u043D\u043E
      \u043A\u0443\u043F\u0438\u0442\u044C \u043F\u043B\u0430\u0441\u0442\u0438\u043A\u043E\u0432\u044B\u0435
      \u043F\u043E\u0434\u0441\u0442\u0430\u0432\u043A\u0438 \u0434\u043B\u044F \u0433\u043E\u0442\u043E\u0432\u044B\u0445
      \u043A\u0430\u0448\u043F\u043E"
