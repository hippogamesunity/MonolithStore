  ItemMetas:
  - Id: Concept
    Title: "\u041A\u0430\u0448\u043F\u043E %TITLE% \u0438\u0437 \u0433\u0438\u043F\u0441\u0430,
      \u0430\u0432\u0442\u043E\u0440\u0441\u043A\u043E\u0435, \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0437\u043C,
      \u043B\u043E\u0444\u0442, monolith, \u0433\u043E\u0440\u0448\u043E\u043A \u0434\u043B\u044F
      \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439"
    Description: "\u041C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u043E\u0435
      \u043A\u0430\u0448\u043F\u043E %TITLE% \u0441\u043E\u0437\u0434\u0430\u043D\u043E
      \u0434\u043B\u044F \u0442\u0435\u0445, \u043A\u0442\u043E \u0446\u0435\u043D\u0438\u0442
      \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u0438
      \u0438 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
      \u0434\u0438\u0437\u0430\u0439\u043D\u0430. \u0410\u0432\u0442\u043E\u0440\u0441\u043A\u0430\u044F
      \u0441\u0435\u0440\u0438\u044F %COLLECTION%. \u042F \u0441\u0430\u043C \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E
      \u0434\u0438\u0437\u0430\u0439\u043D \u043A\u0430\u0448\u043F\u043E \u0438
      \u0438\u0437\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u044E \u043C\u043E\u043B\u0434\u044B.\n\n\u041A\u0430\u0448\u043F\u043E
      \u0441\u0434\u0435\u043B\u0430\u043D\u043E \u0438\u0437 \u0433\u0438\u043F\u0441\u0430
      \u0441 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C \u043C\u0440\u0430\u043C\u043E\u0440\u043D\u043E\u0439
      \u043C\u0443\u043A\u0438, \u0431\u0435\u043B\u043E\u0433\u043E \u0446\u0435\u043C\u0435\u043D\u0442\u0430,
      \u0434\u0438\u043E\u043A\u0441\u0438\u0434\u0430 \u0442\u0438\u0442\u0430\u043D\u0430
      \u0438 \u0444\u0438\u0431\u0440\u043E\u0432\u043E\u043B\u043E\u043A\u043D\u0430,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043E\u043D\u043E \u0441\u0432\u0435\u0442\u043B\u043E\u0435
      \u0438 \u043F\u0440\u043E\u0447\u043D\u043E\u0435. \u0421\u0442\u0440\u043E\u0433\u0430\u044F
      \u0446\u0438\u043B\u0438\u043D\u0434\u0440\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0444\u043E\u0440\u043C\u0430 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E
      \u0432\u043F\u0438\u0448\u0435\u0442\u0441\u044F \u0432 \u0438\u043D\u0442\u0435\u0440\u044C\u0435\u0440\u044B
      \u0432 \u0441\u0442\u0438\u043B\u0435 \u043B\u043E\u0444\u0442 \u0438\u043B\u0438
      \u0441\u043A\u0430\u043D\u0434\u0438\u043D\u0430\u0432\u0441\u043A\u0438\u0439
      \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0437\u043C, \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0441\u044C
      \u0430\u043A\u0446\u0435\u043D\u0442\u043D\u043E\u0439 \u0434\u0435\u0442\u0430\u043B\u044C\u044E
      \u043B\u044E\u0431\u043E\u0433\u043E \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430.
      \u0420\u0430\u0437\u043C\u0435\u0440\u044B \u0438\u0437\u0434\u0435\u043B\u0438\u044F
      \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442 \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u043E\u0435
      \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u043B\u044E\u0431\u044B\u0445
      \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439. \u041A\u0430\u0448\u043F\u043E
      \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432
      \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0435 \u0441\u043E \u0441\u0442\u0438\u043B\u044C\u043D\u043E\u0439
      \u043F\u043E\u0434\u0441\u0442\u0430\u0432\u043A\u043E\u0439, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u044F \u0442\u043E\u0436\u0435 \u0441\u043E\u0437\u0434\u0430\u044E \u0441\u0430\u043C.\n\n\u0427\u0442\u043E
      \u0435\u0449\u0435 \u0432\u0430\u0436\u043D\u043E \u0437\u043D\u0430\u0442\u044C
      \u043F\u0435\u0440\u0435\u0434 \u043F\u043E\u043A\u0443\u043F\u043A\u043E\u0439:\n\n-
      \u042F \u0434\u0435\u043B\u0430\u044E \u043A\u0430\u0448\u043F\u043E \u0432\u0440\u0443\u0447\u043D\u0443\u044E,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
      \u0438\u0437\u0434\u0435\u043B\u0438\u044F \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u043F\u0443\u0437\u044B\u0440\u044C\u043A\u0438.\n\n-
      \u042F \u043D\u0435 \u043D\u0430\u043D\u043E\u0448\u0443 \u043B\u0430\u043A
      \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0446\u0435\u043D\u044E
      \u043D\u0430\u0442\u0443\u0440\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u0438 \u044D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u043E\u0441\u0442\u044C.
      \u041F\u0440\u0438 \u0447\u0440\u0435\u0437\u043C\u0435\u0440\u043D\u043E\u043C
      \u043F\u043E\u043B\u0438\u0432\u0435 \u043A\u0430\u0448\u043F\u043E \u043C\u043E\u0436\u0435\u0442
      \u0432\u043F\u0438\u0442\u044B\u0432\u0430\u0442\u044C \u0432\u043B\u0430\u0433\u0443
      \u0438 \u043D\u0430\u043C\u043E\u043A\u043D\u0443\u0442\u044C (\u043D\u043E
      \u0432\u044B\u0441\u043E\u0445\u043D\u0435\u0442 \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C).\n\n-
      \u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0433\u043E\u0440\u0448\u043E\u043A
      \u0438 \u043F\u043E\u0434\u0434\u043E\u043D \u043C\u043E\u0436\u043D\u043E
      \u043A\u0443\u043F\u0438\u0442\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E
      (\u0430\u0440\u0442. 4883010856). \u041A\u0430\u0448\u043F\u043E \u043D\u0435
      \u043D\u0430\u043C\u043E\u043A\u043D\u0435\u0442, \u0430 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0435
      \u043D\u0435 \u0437\u0430\u0441\u043E\u0445\u043D\u0435\u0442.\n\n- \u0420\u0430\u0441\u0442\u0435\u043D\u0438\u0435
      \u041D\u0415 \u0412\u0425\u041E\u0414\u0418\u0422 \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442.\n\n-
      \u041F\u043E\u0434\u0441\u0442\u0430\u0432\u043A\u0430 \u0412\u0425\u041E\u0414\u0418\u0422
      \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442."
  - Id: Simple with Stand
    Title: "\u041A\u0430\u0448\u043F\u043E %TITLE% \u0438\u0437 \u0433\u0438\u043F\u0441\u0430,
      \u0430\u0432\u0442\u043E\u0440\u0441\u043A\u043E\u0435, \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0437\u043C,
      \u043B\u043E\u0444\u0442, monolith, \u0433\u043E\u0440\u0448\u043E\u043A \u0434\u043B\u044F
      \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439"
    Description: "\u041C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u043E\u0435
      \u043A\u0430\u0448\u043F\u043E %TITLE% \u0441\u043E\u0437\u0434\u0430\u043D\u043E
      \u0434\u043B\u044F \u0442\u0435\u0445, \u043A\u0442\u043E \u0446\u0435\u043D\u0438\u0442
      \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u0438
      \u0438 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
      \u0434\u0438\u0437\u0430\u0439\u043D\u0430. \u0410\u0432\u0442\u043E\u0440\u0441\u043A\u0430\u044F
      \u0441\u0435\u0440\u0438\u044F %COLLECTION%. \u042F \u0441\u0430\u043C \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E
      \u0434\u0438\u0437\u0430\u0439\u043D \u043A\u0430\u0448\u043F\u043E \u0438
      \u0438\u0437\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u044E \u043C\u043E\u043B\u0434\u044B.\n\n\u041A\u0430\u0448\u043F\u043E
      \u0441\u0434\u0435\u043B\u0430\u043D\u043E \u0438\u0437 \u0433\u0438\u043F\u0441\u0430
      \u0441 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C \u043C\u0440\u0430\u043C\u043E\u0440\u043D\u043E\u0439
      \u043C\u0443\u043A\u0438, \u0431\u0435\u043B\u043E\u0433\u043E \u0446\u0435\u043C\u0435\u043D\u0442\u0430,
      \u0434\u0438\u043E\u043A\u0441\u0438\u0434\u0430 \u0442\u0438\u0442\u0430\u043D\u0430
      \u0438 \u0444\u0438\u0431\u0440\u043E\u0432\u043E\u043B\u043E\u043A\u043D\u0430,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043E\u043D\u043E \u0441\u0432\u0435\u0442\u043B\u043E\u0435
      \u0438 \u043F\u0440\u043E\u0447\u043D\u043E\u0435. \u0421\u0442\u0440\u043E\u0433\u0430\u044F
      \u0446\u0438\u043B\u0438\u043D\u0434\u0440\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0444\u043E\u0440\u043C\u0430 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E
      \u0432\u043F\u0438\u0448\u0435\u0442\u0441\u044F \u0432 \u0438\u043D\u0442\u0435\u0440\u044C\u0435\u0440\u044B
      \u0432 \u0441\u0442\u0438\u043B\u0435 \u043B\u043E\u0444\u0442 \u0438\u043B\u0438
      \u0441\u043A\u0430\u043D\u0434\u0438\u043D\u0430\u0432\u0441\u043A\u0438\u0439
      \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0437\u043C, \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0441\u044C
      \u0430\u043A\u0446\u0435\u043D\u0442\u043D\u043E\u0439 \u0434\u0435\u0442\u0430\u043B\u044C\u044E
      \u043B\u044E\u0431\u043E\u0433\u043E \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430.
      \u0420\u0430\u0437\u043C\u0435\u0440\u044B \u0438\u0437\u0434\u0435\u043B\u0438\u044F
      \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442 \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u043E\u0435
      \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u043B\u044E\u0431\u044B\u0445
      \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439. \u041A\u0430\u0448\u043F\u043E
      \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432
      \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0435 \u0441\u043E \u0441\u0442\u0438\u043B\u044C\u043D\u043E\u0439
      \u043F\u043E\u0434\u0441\u0442\u0430\u0432\u043A\u043E\u0439, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u044F \u0442\u043E\u0436\u0435 \u0441\u043E\u0437\u0434\u0430\u044E \u0441\u0430\u043C.\n\n\u0427\u0442\u043E
      \u0435\u0449\u0435 \u0432\u0430\u0436\u043D\u043E \u0437\u043D\u0430\u0442\u044C
      \u043F\u0435\u0440\u0435\u0434 \u043F\u043E\u043A\u0443\u043F\u043A\u043E\u0439:\n\n-
      \u042F \u0434\u0435\u043B\u0430\u044E \u043A\u0430\u0448\u043F\u043E \u0432\u0440\u0443\u0447\u043D\u0443\u044E,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
      \u0438\u0437\u0434\u0435\u043B\u0438\u044F \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u043F\u0443\u0437\u044B\u0440\u044C\u043A\u0438.\n\n-
      \u042F \u043D\u0435 \u043D\u0430\u043D\u043E\u0448\u0443 \u043B\u0430\u043A
      \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0446\u0435\u043D\u044E
      \u043D\u0430\u0442\u0443\u0440\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u0438 \u044D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u043E\u0441\u0442\u044C.
      \u041F\u0440\u0438 \u0447\u0440\u0435\u0437\u043C\u0435\u0440\u043D\u043E\u043C
      \u043F\u043E\u043B\u0438\u0432\u0435 \u043A\u0430\u0448\u043F\u043E \u043C\u043E\u0436\u0435\u0442
      \u0432\u043F\u0438\u0442\u044B\u0432\u0430\u0442\u044C \u0432\u043B\u0430\u0433\u0443
      \u0438 \u043D\u0430\u043C\u043E\u043A\u043D\u0443\u0442\u044C (\u043D\u043E
      \u0432\u044B\u0441\u043E\u0445\u043D\u0435\u0442 \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C).\n\n-
      \u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0433\u043E\u0440\u0448\u043E\u043A
      \u0438 \u043F\u043E\u0434\u0434\u043E\u043D \u043C\u043E\u0436\u043D\u043E
      \u043A\u0443\u043F\u0438\u0442\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E
      (\u0430\u0440\u0442. 4291586934). \u041A\u0430\u0448\u043F\u043E \u043D\u0435
      \u043D\u0430\u043C\u043E\u043A\u043D\u0435\u0442, \u0430 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0435
      \u043D\u0435 \u0437\u0430\u0441\u043E\u0445\u043D\u0435\u0442.\n\n- \u0420\u0430\u0441\u0442\u0435\u043D\u0438\u0435
      \u041D\u0415 \u0412\u0425\u041E\u0414\u0418\u0422 \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442.\n\n-
      \u041F\u043E\u0434\u0441\u0442\u0430\u0432\u043A\u0430 \u0412\u0425\u041E\u0414\u0418\u0422
      \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442."
  - Id: Concept Max
    Title: "\u041A\u0430\u0448\u043F\u043E %TITLE% \u0438\u0437 \u0433\u0438\u043F\u0441\u0430,
      \u0430\u0432\u0442\u043E\u0440\u0441\u043A\u043E\u0435, \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0437\u043C,
      \u043B\u043E\u0444\u0442, monolith, \u0433\u043E\u0440\u0448\u043E\u043A \u0434\u043B\u044F
      \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439"
    Description: "\u041C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u043E\u0435
      \u043A\u0430\u0448\u043F\u043E %TITLE% \u0441\u043E\u0437\u0434\u0430\u043D\u043E
      \u0434\u043B\u044F \u0442\u0435\u0445, \u043A\u0442\u043E \u0446\u0435\u043D\u0438\u0442
      \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u0438
      \u0438 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
      \u0434\u0438\u0437\u0430\u0439\u043D\u0430. \u0410\u0432\u0442\u043E\u0440\u0441\u043A\u0430\u044F
      \u0441\u0435\u0440\u0438\u044F %COLLECTION%. \u042F \u0441\u0430\u043C \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E
      \u0434\u0438\u0437\u0430\u0439\u043D \u043A\u0430\u0448\u043F\u043E \u0438
      \u0438\u0437\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u044E \u043C\u043E\u043B\u0434\u044B.\n\n\u041A\u0430\u0448\u043F\u043E
      \u0441\u0434\u0435\u043B\u0430\u043D\u043E \u0438\u0437 \u0433\u0438\u043F\u0441\u0430
      \u0441 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C \u043C\u0440\u0430\u043C\u043E\u0440\u043D\u043E\u0439
      \u043C\u0443\u043A\u0438, \u0431\u0435\u043B\u043E\u0433\u043E \u0446\u0435\u043C\u0435\u043D\u0442\u0430,
      \u0434\u0438\u043E\u043A\u0441\u0438\u0434\u0430 \u0442\u0438\u0442\u0430\u043D\u0430
      \u0438 \u0444\u0438\u0431\u0440\u043E\u0432\u043E\u043B\u043E\u043A\u043D\u0430,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043E\u043D\u043E \u0441\u0432\u0435\u0442\u043B\u043E\u0435
      \u0438 \u043F\u0440\u043E\u0447\u043D\u043E\u0435. \u0421\u0442\u0440\u043E\u0433\u0430\u044F
      \u0446\u0438\u043B\u0438\u043D\u0434\u0440\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0444\u043E\u0440\u043C\u0430 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E
      \u0432\u043F\u0438\u0448\u0435\u0442\u0441\u044F \u0432 \u0438\u043D\u0442\u0435\u0440\u044C\u0435\u0440\u044B
      \u0432 \u0441\u0442\u0438\u043B\u0435 \u043B\u043E\u0444\u0442 \u0438\u043B\u0438
      \u0441\u043A\u0430\u043D\u0434\u0438\u043D\u0430\u0432\u0441\u043A\u0438\u0439
      \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0437\u043C, \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0441\u044C
      \u0430\u043A\u0446\u0435\u043D\u0442\u043D\u043E\u0439 \u0434\u0435\u0442\u0430\u043B\u044C\u044E
      \u043B\u044E\u0431\u043E\u0433\u043E \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430.
      \u0420\u0430\u0437\u043C\u0435\u0440\u044B \u0438\u0437\u0434\u0435\u043B\u0438\u044F
      \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442 \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u043E\u0435
      \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u043B\u044E\u0431\u044B\u0445
      \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439. \u041A\u0430\u0448\u043F\u043E
      \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432
      \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0435 \u0441\u043E \u0441\u0442\u0438\u043B\u044C\u043D\u043E\u0439
      \u043F\u043E\u0434\u0441\u0442\u0430\u0432\u043A\u043E\u0439, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u044F \u0442\u043E\u0436\u0435 \u0441\u043E\u0437\u0434\u0430\u044E \u0441\u0430\u043C.\n\n\u0427\u0442\u043E
      \u0435\u0449\u0435 \u0432\u0430\u0436\u043D\u043E \u0437\u043D\u0430\u0442\u044C
      \u043F\u0435\u0440\u0435\u0434 \u043F\u043E\u043A\u0443\u043F\u043A\u043E\u0439:\n\n-
      \u042F \u0434\u0435\u043B\u0430\u044E \u043A\u0430\u0448\u043F\u043E \u0432\u0440\u0443\u0447\u043D\u0443\u044E,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
      \u0438\u0437\u0434\u0435\u043B\u0438\u044F \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u043F\u0443\u0437\u044B\u0440\u044C\u043A\u0438.\n\n-
      \u042F \u043D\u0435 \u043D\u0430\u043D\u043E\u0448\u0443 \u043B\u0430\u043A
      \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0446\u0435\u043D\u044E
      \u043D\u0430\u0442\u0443\u0440\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u0438 \u044D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u043E\u0441\u0442\u044C.
      \u041F\u0440\u0438 \u0447\u0440\u0435\u0437\u043C\u0435\u0440\u043D\u043E\u043C
      \u043F\u043E\u043B\u0438\u0432\u0435 \u043A\u0430\u0448\u043F\u043E \u043C\u043E\u0436\u0435\u0442
      \u0432\u043F\u0438\u0442\u044B\u0432\u0430\u0442\u044C \u0432\u043B\u0430\u0433\u0443
      \u0438 \u043D\u0430\u043C\u043E\u043A\u043D\u0443\u0442\u044C (\u043D\u043E
      \u0432\u044B\u0441\u043E\u0445\u043D\u0435\u0442 \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C).\n\n-
      \u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0433\u043E\u0440\u0448\u043E\u043A
      \u0438 \u043F\u043E\u0434\u0434\u043E\u043D \u043C\u043E\u0436\u043D\u043E
      \u043A\u0443\u043F\u0438\u0442\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E
      (\u0430\u0440\u0442. 4882977695). \u041A\u0430\u0448\u043F\u043E \u043D\u0435
      \u043D\u0430\u043C\u043E\u043A\u043D\u0435\u0442, \u0430 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0435
      \u043D\u0435 \u0437\u0430\u0441\u043E\u0445\u043D\u0435\u0442.\n\n- \u0420\u0430\u0441\u0442\u0435\u043D\u0438\u0435
      \u041D\u0415 \u0412\u0425\u041E\u0414\u0418\u0422 \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442.\n\n-
      \u041F\u043E\u0434\u0441\u0442\u0430\u0432\u043A\u0430 \u0412\u0425\u041E\u0414\u0418\u0422
      \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442."
  - Id: Simple
    Title: "\u041A\u0430\u0448\u043F\u043E %TITLE% \u0438\u0437 \u0433\u0438\u043F\u0441\u0430,
      \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0437\u043C, \u043B\u043E\u0444\u0442,
      monolith, \u0433\u043E\u0440\u0448\u043E\u043A \u0434\u043B\u044F \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439"
    Description: "\u041C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u043E\u0435
      \u043A\u0430\u0448\u043F\u043E %TITLE% \u0441\u043E\u0437\u0434\u0430\u043D\u043E
      \u0434\u043B\u044F \u0442\u0435\u0445, \u043A\u0442\u043E \u0446\u0435\u043D\u0438\u0442
      \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u0438
      \u0438 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
      \u0434\u0438\u0437\u0430\u0439\u043D\u0430. \u0410\u0432\u0442\u043E\u0440\u0441\u043A\u0430\u044F
      \u0441\u0435\u0440\u0438\u044F %COLLECTION%. \u042F \u0441\u0430\u043C \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E
      \u0434\u0438\u0437\u0430\u0439\u043D \u043A\u0430\u0448\u043F\u043E \u0438
      \u0438\u0437\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u044E \u043C\u043E\u043B\u0434\u044B.\n\n\u041A\u0430\u0448\u043F\u043E
      \u0441\u0434\u0435\u043B\u0430\u043D\u043E \u0438\u0437 \u0433\u0438\u043F\u0441\u0430
      \u0441 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C \u043C\u0440\u0430\u043C\u043E\u0440\u043D\u043E\u0439
      \u043C\u0443\u043A\u0438, \u0431\u0435\u043B\u043E\u0433\u043E \u0446\u0435\u043C\u0435\u043D\u0442\u0430,
      \u0434\u0438\u043E\u043A\u0441\u0438\u0434\u0430 \u0442\u0438\u0442\u0430\u043D\u0430
      \u0438 \u0444\u0438\u0431\u0440\u043E\u0432\u043E\u043B\u043E\u043A\u043D\u0430,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043E\u043D\u043E \u0441\u0432\u0435\u0442\u043B\u043E\u0435
      \u0438 \u043F\u0440\u043E\u0447\u043D\u043E\u0435. \u0421\u0442\u0440\u043E\u0433\u0430\u044F
      \u0446\u0438\u043B\u0438\u043D\u0434\u0440\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0444\u043E\u0440\u043C\u0430 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E
      \u0432\u043F\u0438\u0448\u0435\u0442\u0441\u044F \u0432 \u0438\u043D\u0442\u0435\u0440\u044C\u0435\u0440\u044B
      \u0432 \u0441\u0442\u0438\u043B\u0435 \u043B\u043E\u0444\u0442 \u0438\u043B\u0438
      \u0441\u043A\u0430\u043D\u0434\u0438\u043D\u0430\u0432\u0441\u043A\u0438\u0439
      \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0437\u043C, \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0441\u044C
      \u0430\u043A\u0446\u0435\u043D\u0442\u043D\u043E\u0439 \u0434\u0435\u0442\u0430\u043B\u044C\u044E
      \u043B\u044E\u0431\u043E\u0433\u043E \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430.
      \u0420\u0430\u0437\u043C\u0435\u0440\u044B \u0438\u0437\u0434\u0435\u043B\u0438\u044F
      \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442 \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u043E\u0435
      \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u043B\u044E\u0431\u044B\u0445
      \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439. \u041A\u0430\u0448\u043F\u043E
      \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432
      \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0435 \u0441\u043E \u0441\u0442\u0438\u043B\u044C\u043D\u043E\u0439
      \u043F\u043E\u0434\u0441\u0442\u0430\u0432\u043A\u043E\u0439, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u044F \u0442\u043E\u0436\u0435 \u0441\u043E\u0437\u0434\u0430\u044E \u0441\u0430\u043C.\n\n\u0427\u0442\u043E
      \u0435\u0449\u0435 \u0432\u0430\u0436\u043D\u043E \u0437\u043D\u0430\u0442\u044C
      \u043F\u0435\u0440\u0435\u0434 \u043F\u043E\u043A\u0443\u043F\u043A\u043E\u0439:\n\n-
      \u042F \u0434\u0435\u043B\u0430\u044E \u043A\u0430\u0448\u043F\u043E \u0432\u0440\u0443\u0447\u043D\u0443\u044E,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
      \u0438\u0437\u0434\u0435\u043B\u0438\u044F \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u043F\u0443\u0437\u044B\u0440\u044C\u043A\u0438.\n\n-
      \u042F \u043D\u0435 \u043D\u0430\u043D\u043E\u0448\u0443 \u043B\u0430\u043A
      \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0446\u0435\u043D\u044E
      \u043D\u0430\u0442\u0443\u0440\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u0438 \u044D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u043E\u0441\u0442\u044C.
      \u041F\u0440\u0438 \u0447\u0440\u0435\u0437\u043C\u0435\u0440\u043D\u043E\u043C
      \u043F\u043E\u043B\u0438\u0432\u0435 \u043A\u0430\u0448\u043F\u043E \u043C\u043E\u0436\u0435\u0442
      \u0432\u043F\u0438\u0442\u044B\u0432\u0430\u0442\u044C \u0432\u043B\u0430\u0433\u0443
      \u0438 \u043D\u0430\u043C\u043E\u043A\u043D\u0443\u0442\u044C (\u043D\u043E
      \u0432\u044B\u0441\u043E\u0445\u043D\u0435\u0442 \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C).\n\n-
      \u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0433\u043E\u0440\u0448\u043E\u043A
      \u0438 \u043F\u043E\u0434\u0434\u043E\u043D \u043C\u043E\u0436\u043D\u043E
      \u043A\u0443\u043F\u0438\u0442\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E
      (\u0430\u0440\u0442. 4291586934). \u041A\u0430\u0448\u043F\u043E \u043D\u0435
      \u043D\u0430\u043C\u043E\u043A\u043D\u0435\u0442, \u0430 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0435
      \u043D\u0435 \u0437\u0430\u0441\u043E\u0445\u043D\u0435\u0442.\n\n- \u0420\u0430\u0441\u0442\u0435\u043D\u0438\u0435
      \u041D\u0415 \u0412\u0425\u041E\u0414\u0418\u0422 \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442."
  - Id: Plastic Prism
    Title: "\u041A\u0430\u0448\u043F\u043E %TITLE%  \u0434\u0432\u0443\u0445\u0446\u0432\u0435\u0442\u043D\u043E\u0435,
      \u0434\u043B\u044F \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439, \u0441
      \u043F\u043E\u0434\u0434\u043E\u043D\u043E\u043C \u0438 \u0430\u0432\u0442\u043E\u043F\u043E\u043B\u0438\u0432\u043E\u043C,
      \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0437\u043C, \u043B\u043E\u0444\u0442,
      monolith"
    Description: "\u041C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u043E\u0435
      \u043A\u0430\u0448\u043F\u043E %TITLE% \u0441\u043E\u0437\u0434\u0430\u043D\u043E
      \u0434\u043B\u044F \u0442\u0435\u0445, \u043A\u0442\u043E \u0446\u0435\u043D\u0438\u0442
      \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u0438
      \u0438 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
      \u0434\u0438\u0437\u0430\u0439\u043D\u0430. \u041A\u0430\u0448\u043F\u043E
      \u0441\u0434\u0435\u043B\u0430\u043D\u043E \u0438\u0437 \u043F\u0440\u0435\u043C\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      PLA-\u043F\u043B\u0430\u0441\u0442\u0438\u043A\u0430, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u043E\u043D\u043E \u043B\u0435\u0433\u043A\u043E\u0435 \u0438 \u043F\u0440\u043E\u0447\u043D\u043E\u0435.
      \u0421\u0442\u0440\u043E\u0433\u0430\u044F \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0430\u044F
      \u0444\u043E\u0440\u043C\u0430 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E
      \u0432\u043F\u0438\u0448\u0435\u0442\u0441\u044F \u0432 \u0438\u043D\u0442\u0435\u0440\u044C\u0435\u0440\u044B
      \u0432 \u0441\u0442\u0438\u043B\u0435 \u043B\u043E\u0444\u0442 \u0438\u043B\u0438
      \u0441\u043A\u0430\u043D\u0434\u0438\u043D\u0430\u0432\u0441\u043A\u0438\u0439
      \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0437\u043C, \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0441\u044C
      \u0430\u043A\u0446\u0435\u043D\u0442\u043D\u043E\u0439 \u0434\u0435\u0442\u0430\u043B\u044C\u044E
      \u043B\u044E\u0431\u043E\u0433\u043E \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430.
      \u0420\u0430\u0437\u043C\u0435\u0440\u044B \u0438\u0437\u0434\u0435\u043B\u0438\u044F
      \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442 \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u043E\u0435
      \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0445
      \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439, \u0430 \u043F\u043E\u0434\u0434\u043E\u043D
      \u0437\u0430\u0449\u0438\u0442\u0438\u0442 \u0438\u0445 \u043E\u0442 \u043F\u0435\u0440\u0435\u043B\u0438\u0432\u0430.\n\n\u0410\u0432\u0442\u043E\u0440\u0441\u043A\u0430\u044F
      \u0441\u0435\u0440\u0438\u044F %COLLECTION%. \u042F \u0441\u0430\u043C \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E
      \u0434\u0438\u0437\u0430\u0439\u043D \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E
      \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u0435\u043C\u0438\u0430\u043B\u044C\u043D\u044B\u0439
      PLA-\u043F\u043B\u0430\u0441\u0442\u0438\u043A \u0434\u043B\u044F \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430.
      \n\n\u0427\u0442\u043E \u0435\u0449\u0435 \u0432\u0430\u0436\u043D\u043E \u0437\u043D\u0430\u0442\u044C
      \u043F\u0435\u0440\u0435\u0434 \u043F\u043E\u043A\u0443\u043F\u043A\u043E\u0439:\n\n-
      \u0420\u0430\u0441\u0442\u0435\u043D\u0438\u0435 \u041D\u0415 \u0412\u0425\u041E\u0414\u0418\u0422
      \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442.\n\n- \u041F\u043E\u0434\u0434\u043E\u043D
      \u0438 \u0430\u0432\u0442\u043E\u043F\u043E\u043B\u0438\u0432 \u0412\u0425\u041E\u0414\u042F\u0422
      \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442."
  - Id: Plastic Onyx
    Title: "\u041A\u0430\u0448\u043F\u043E %TITLE%  \u0434\u0432\u0443\u0445\u0446\u0432\u0435\u0442\u043D\u043E\u0435,
      \u0434\u043B\u044F \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439, \u0441
      \u043F\u043E\u0434\u0434\u043E\u043D\u043E\u043C \u0438 \u0430\u0432\u0442\u043E\u043F\u043E\u043B\u0438\u0432\u043E\u043C,
      \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0437\u043C, \u043B\u043E\u0444\u0442,
      monolith"
    Description: "\u041C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u043E\u0435
      \u043A\u0430\u0448\u043F\u043E %TITLE% \u0441\u043E\u0437\u0434\u0430\u043D\u043E
      \u0434\u043B\u044F \u0442\u0435\u0445, \u043A\u0442\u043E \u0446\u0435\u043D\u0438\u0442
      \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u0438
      \u0438 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
      \u0434\u0438\u0437\u0430\u0439\u043D\u0430. \u041A\u0430\u0448\u043F\u043E
      \u0441\u0434\u0435\u043B\u0430\u043D\u043E \u0438\u0437 \u043F\u0440\u0435\u043C\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0443\u0433\u043B\u0435\u043F\u043B\u0430\u0441\u0442\u0438\u043A\u0430, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u043E\u043D\u043E \u043B\u0435\u0433\u043A\u043E\u0435 \u0438 \u043F\u0440\u043E\u0447\u043D\u043E\u0435.
      \u0421\u0442\u0440\u043E\u0433\u0430\u044F \u0446\u0438\u043B\u0438\u043D\u0434\u0440\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0444\u043E\u0440\u043C\u0430 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E
      \u0432\u043F\u0438\u0448\u0435\u0442\u0441\u044F \u0432 \u0438\u043D\u0442\u0435\u0440\u044C\u0435\u0440\u044B
      \u0432 \u0441\u0442\u0438\u043B\u0435 \u043B\u043E\u0444\u0442 \u0438\u043B\u0438
      \u0441\u043A\u0430\u043D\u0434\u0438\u043D\u0430\u0432\u0441\u043A\u0438\u0439
      \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0437\u043C, \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0441\u044C
      \u0430\u043A\u0446\u0435\u043D\u0442\u043D\u043E\u0439 \u0434\u0435\u0442\u0430\u043B\u044C\u044E
      \u043B\u044E\u0431\u043E\u0433\u043E \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430.
      \u0420\u0430\u0437\u043C\u0435\u0440\u044B \u0438\u0437\u0434\u0435\u043B\u0438\u044F
      \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442 \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u043E\u0435
      \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0445
      \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439, \u0430 \u043F\u043E\u0434\u0434\u043E\u043D
      \u0437\u0430\u0449\u0438\u0442\u0438\u0442 \u0438\u0445 \u043E\u0442 \u043F\u0435\u0440\u0435\u043B\u0438\u0432\u0430.\n\n\u0410\u0432\u0442\u043E\u0440\u0441\u043A\u0430\u044F
      \u0441\u0435\u0440\u0438\u044F %COLLECTION%. \u042F \u0441\u0430\u043C \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E
      \u0434\u0438\u0437\u0430\u0439\u043D \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E
      \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u0435\u043C\u0438\u0430\u043B\u044C\u043D\u044B\u0439
      \u0443\u0433\u043B\u0435\u043F\u043B\u0430\u0441\u0442\u0438\u043A \u0434\u043B\u044F
      \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430. \n\n\u0427\u0442\u043E
      \u0435\u0449\u0435 \u0432\u0430\u0436\u043D\u043E \u0437\u043D\u0430\u0442\u044C
      \u043F\u0435\u0440\u0435\u0434 \u043F\u043E\u043A\u0443\u043F\u043A\u043E\u0439:\n\n-
      \u0420\u0430\u0441\u0442\u0435\u043D\u0438\u0435 \u041D\u0415 \u0412\u0425\u041E\u0414\u0418\u0422
      \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442.\n\n- \u041F\u043E\u0434\u0434\u043E\u043D
      \u0438 \u0430\u0432\u0442\u043E\u043F\u043E\u043B\u0438\u0432 \u0412\u0425\u041E\u0414\u042F\u0422
      \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442."
  - Id: Plastic2
    Title: "\u041A\u0430\u0448\u043F\u043E %TITLE%  \u0441 \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u043C
      \u0442\u0435\u0445. \u0433\u043E\u0440\u0448\u043A\u043E\u043C, \u0434\u043B\u044F
      \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439, \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0437\u043C,
      \u043B\u043E\u0444\u0442, monolith"
    Description: "\u041C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u043E\u0435
      \u043A\u0430\u0448\u043F\u043E %TITLE% \u0441\u043E\u0437\u0434\u0430\u043D\u043E
      \u0434\u043B\u044F \u0442\u0435\u0445, \u043A\u0442\u043E \u0446\u0435\u043D\u0438\u0442
      \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u0438
      \u0438 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
      \u0434\u0438\u0437\u0430\u0439\u043D\u0430. \u041A\u0430\u0448\u043F\u043E
      \u0441\u0434\u0435\u043B\u0430\u043D\u043E \u0438\u0437 \u043F\u0440\u0435\u043C\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0443\u0433\u043B\u0435\u043F\u043B\u0430\u0441\u0442\u0438\u043A\u0430, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u043E\u043D\u043E \u043B\u0435\u0433\u043A\u043E\u0435 \u0438 \u043F\u0440\u043E\u0447\u043D\u043E\u0435.
      \u0421\u0442\u0440\u043E\u0433\u0430\u044F \u0446\u0438\u043B\u0438\u043D\u0434\u0440\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0444\u043E\u0440\u043C\u0430 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E
      \u0432\u043F\u0438\u0448\u0435\u0442\u0441\u044F \u0432 \u0438\u043D\u0442\u0435\u0440\u044C\u0435\u0440\u044B
      \u0432 \u0441\u0442\u0438\u043B\u0435 \u043B\u043E\u0444\u0442 \u0438\u043B\u0438
      \u0441\u043A\u0430\u043D\u0434\u0438\u043D\u0430\u0432\u0441\u043A\u0438\u0439
      \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0437\u043C, \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0441\u044C
      \u0430\u043A\u0446\u0435\u043D\u0442\u043D\u043E\u0439 \u0434\u0435\u0442\u0430\u043B\u044C\u044E
      \u043B\u044E\u0431\u043E\u0433\u043E \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430.
      \u0420\u0430\u0437\u043C\u0435\u0440\u044B \u0438\u0437\u0434\u0435\u043B\u0438\u044F
      \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442 \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u043E\u0435
      \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0445
      \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439, \u0430 \u043F\u043E\u0434\u0434\u043E\u043D
      \u0437\u0430\u0449\u0438\u0442\u0438\u0442 \u0438\u0445 \u043E\u0442 \u043F\u0435\u0440\u0435\u043B\u0438\u0432\u0430.\n\n\u0410\u0432\u0442\u043E\u0440\u0441\u043A\u0430\u044F
      \u0441\u0435\u0440\u0438\u044F %COLLECTION%. \u042F \u0441\u0430\u043C \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E
      \u0434\u0438\u0437\u0430\u0439\u043D \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E
      \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u0435\u043C\u0438\u0430\u043B\u044C\u043D\u044B\u0439
      \u0443\u0433\u043B\u0435\u043F\u043B\u0430\u0441\u0442\u0438\u043A \u0434\u043B\u044F
      \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430. \n\n\u0427\u0442\u043E
      \u0435\u0449\u0435 \u0432\u0430\u0436\u043D\u043E \u0437\u043D\u0430\u0442\u044C
      \u043F\u0435\u0440\u0435\u0434 \u043F\u043E\u043A\u0443\u043F\u043A\u043E\u0439:\n\n-
      \u0420\u0430\u0441\u0442\u0435\u043D\u0438\u0435 \u041D\u0415 \u0412\u0425\u041E\u0414\u0418\u0422
      \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442.\n\n- \u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0433\u043E\u0440\u0448\u043E\u043A \u0412\u0425\u041E\u0414\u0418\u0422 \u0432
      \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442."
  - Id: Simple with Tray
    Title: "\u041A\u0430\u0448\u043F\u043E %TITLE% \u0438\u0437 \u0433\u0438\u043F\u0441\u0430,
      \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0437\u043C, \u043B\u043E\u0444\u0442,
      monolith, \u0433\u043E\u0440\u0448\u043E\u043A \u0434\u043B\u044F \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439"
    Description: "\u041C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u043E\u0435
      \u043A\u0430\u0448\u043F\u043E %TITLE% \u0441\u043E\u0437\u0434\u0430\u043D\u043E
      \u0434\u043B\u044F \u0442\u0435\u0445, \u043A\u0442\u043E \u0446\u0435\u043D\u0438\u0442
      \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u0438
      \u0438 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
      \u0434\u0438\u0437\u0430\u0439\u043D\u0430. \u0410\u0432\u0442\u043E\u0440\u0441\u043A\u0430\u044F
      \u0441\u0435\u0440\u0438\u044F %COLLECTION%. \u042F \u0441\u0430\u043C \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E
      \u0434\u0438\u0437\u0430\u0439\u043D \u043A\u0430\u0448\u043F\u043E \u0438
      \u0438\u0437\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u044E \u043C\u043E\u043B\u0434\u044B.\n\n\u041A\u0430\u0448\u043F\u043E
      \u0441\u0434\u0435\u043B\u0430\u043D\u043E \u0438\u0437 \u0433\u0438\u043F\u0441\u0430
      \u0441 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C \u043C\u0440\u0430\u043C\u043E\u0440\u043D\u043E\u0439
      \u043C\u0443\u043A\u0438, \u0431\u0435\u043B\u043E\u0433\u043E \u0446\u0435\u043C\u0435\u043D\u0442\u0430,
      \u0434\u0438\u043E\u043A\u0441\u0438\u0434\u0430 \u0442\u0438\u0442\u0430\u043D\u0430
      \u0438 \u0444\u0438\u0431\u0440\u043E\u0432\u043E\u043B\u043E\u043A\u043D\u0430,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043E\u043D\u043E \u0441\u0432\u0435\u0442\u043B\u043E\u0435
      \u0438 \u043F\u0440\u043E\u0447\u043D\u043E\u0435. \u0421\u0442\u0440\u043E\u0433\u0430\u044F
      \u0446\u0438\u043B\u0438\u043D\u0434\u0440\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0444\u043E\u0440\u043C\u0430 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E
      \u0432\u043F\u0438\u0448\u0435\u0442\u0441\u044F \u0432 \u0438\u043D\u0442\u0435\u0440\u044C\u0435\u0440\u044B
      \u0432 \u0441\u0442\u0438\u043B\u0435 \u043B\u043E\u0444\u0442 \u0438\u043B\u0438
      \u0441\u043A\u0430\u043D\u0434\u0438\u043D\u0430\u0432\u0441\u043A\u0438\u0439
      \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0437\u043C, \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0441\u044C
      \u0430\u043A\u0446\u0435\u043D\u0442\u043D\u043E\u0439 \u0434\u0435\u0442\u0430\u043B\u044C\u044E
      \u043B\u044E\u0431\u043E\u0433\u043E \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430.
      \u0420\u0430\u0437\u043C\u0435\u0440\u044B \u0438\u0437\u0434\u0435\u043B\u0438\u044F
      \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442 \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u043E\u0435
      \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u043B\u044E\u0431\u044B\u0445
      \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439. \u041A\u0430\u0448\u043F\u043E
      \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432
      \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0435 \u0441 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C
      \u0433\u043E\u0440\u0448\u043A\u043E\u043C \u0438 \u043F\u043E\u0434\u0434\u043E\u043D\u043E\u043C,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u044F \u0442\u043E\u0436\u0435
      \u0441\u043E\u0437\u0434\u0430\u044E \u0441\u0430\u043C.\n\n\u0427\u0442\u043E
      \u0435\u0449\u0435 \u0432\u0430\u0436\u043D\u043E \u0437\u043D\u0430\u0442\u044C
      \u043F\u0435\u0440\u0435\u0434 \u043F\u043E\u043A\u0443\u043F\u043A\u043E\u0439:\n\n-
      \u042F \u0434\u0435\u043B\u0430\u044E \u043A\u0430\u0448\u043F\u043E \u0432\u0440\u0443\u0447\u043D\u0443\u044E,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
      \u0438\u0437\u0434\u0435\u043B\u0438\u044F \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u043F\u0443\u0437\u044B\u0440\u044C\u043A\u0438.\n\n-
      \u042F \u043D\u0435 \u043D\u0430\u043D\u043E\u0448\u0443 \u043B\u0430\u043A
      \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0446\u0435\u043D\u044E
      \u043D\u0430\u0442\u0443\u0440\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u0438 \u044D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u043E\u0441\u0442\u044C.
      \u041F\u0440\u0438 \u0447\u0440\u0435\u0437\u043C\u0435\u0440\u043D\u043E\u043C
      \u043F\u043E\u043B\u0438\u0432\u0435 \u043A\u0430\u0448\u043F\u043E \u043C\u043E\u0436\u0435\u0442
      \u0432\u043F\u0438\u0442\u044B\u0432\u0430\u0442\u044C \u0432\u043B\u0430\u0433\u0443
      \u0438 \u043D\u0430\u043C\u043E\u043A\u043D\u0443\u0442\u044C (\u043D\u043E
      \u0432\u044B\u0441\u043E\u0445\u043D\u0435\u0442 \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C).\n\n-
      \u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0433\u043E\u0440\u0448\u043E\u043A
      \u0438 \u043F\u043E\u0434\u0434\u043E\u043D \u0412\u0425\u041E\u0414\u042F\u0422
      \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442.\n\n- \u0420\u0430\u0441\u0442\u0435\u043D\u0438\u0435
      \u041D\u0415 \u0412\u0425\u041E\u0414\u0418\u0422 \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442."
