  Items:
  - Id: "Simple \u0441 \u043F\u043E\u0434\u0434\u043E\u043D\u043E\u043C"
    Title: Simple
    Collection: PREMIUM PLANTER
    Description: "\u041A\u0430\u0448\u043F\u043E \u0441 \u0442\u0435\u0445. \u0433\u043E\u0440\u0448\u043A\u043E\u043C
      \u0438 \u043F\u043E\u0434\u0434\u043E\u043D\u043E\u043C"
    DescriptionTextSize: 120
    MaterialTitle: "\u041A\u043E\u043C\u043F\u043E\u0437\u0438\u0442\u043D\u044B\u0439
      \u043A\u0430\u043C\u0435\u043D\u044C"
    MaterialDescription: "\u0413\u0438\u043F\u0441, \u0431\u0435\u043B\u044B\u0439
      \u0446\u0435\u043C\u0435\u043D\u0442, \u043C\u0440\u0430\u043C\u043E\u0440\u043D\u0430\u044F
      \u043C\u0443\u043A\u0430, \u043C\u0438\u043D\u0435\u0440\u0430\u043B\u044C\u043D\u044B\u0435
      \u043D\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u0438, \u0430\u0440\u043C\u0438\u0440\u0443\u044E\u0449\u0430\u044F
      \u0444\u0438\u0431\u0440\u0430"
    MaterialDescriptionTextSize: 80
    TrayTitle: "\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0433\u043E\u0440\u0448\u043E\u043A \u0438 \u043F\u043E\u0434\u0434\u043E\u043D"
    TrayDescription: "\u0412 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0435.
      \u041A\u0430\u0448\u043F\u043E \u043D\u0435 \u043D\u0430\u043C\u043E\u043A\u043D\u0435\u0442,
      \u0430 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0435 \u043D\u0435 \u0437\u0430\u0441\u043E\u0445\u043D\u0435\u0442."
    MetaTemplateId: Simple with Tray
    Properties:
    - Text: "\u0413\u0438\u043F\u0441"
