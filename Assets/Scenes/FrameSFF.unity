  - Id: Frame SFF Panels WH
    Title: "\u041A\u043E\u043C\u043F\u043B\u0435\u043A\u0442 \u043F\u0430\u043D\u0435\u043B\u0435\u0439"
    Collection: Frame SFF
    Description: "\u0434\u043B\u044F \u043A\u043E\u0440\u043F\u0443\u0441\u0430 Frame
      SFF"
    DescriptionTextSize: 100
    MaterialTitle: 
    MaterialDescription: 
    MaterialDescriptionTextSize: 80
    TrayTitle: 
    TrayDescription: 
    MetaTemplateId: Frame SFF Panels WH
    Properties: []
    Screenshots:
    - Sprite: {fileID: 21300000, guid: fdc6d52d5b1bd83458201d841bf594cc, type: 3}
      Offset: {x: 0, y: 50}
      Scale: 0.9
      Rotation: 0
  ItemMetas:
  - Id: Frame SFF Lite
    Title: "\u041C\u0443\u043B\u044C\u0442\u0438\u043C\u043E\u043B\u0434 %TITLE%
      \u0434\u043B\u044F \u043A\u0430\u0448\u043F\u043E \u0438\u043B\u0438 \u0433\u043E\u0440\u0448\u043A\u0430
      \u0438\u0437 \u0433\u0438\u043F\u0441\u0430"
    Description: "Frame SFF \u2014 \u0431\u044E\u0434\u0436\u0435\u0442\u043D\u044B\u0439
      SFF-\u043A\u043E\u0440\u043F\u0443\u0441 \u0434\u043B\u044F \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u043E\u0433\u043E
      \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430 \u043D\u0430 \u043E\u0431\u044B\u0447\u043D\u043E\u0439
      \u043C\u0430\u0442\u0435\u0440\u0438\u043D\u0441\u043A\u043E\u0439 \u043F\u043B\u0430\u0442\u0435
      mATX. \u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
      \u043A\u0430\u043A \u043F\u043E\u043B\u043D\u043E\u0440\u0430\u0437\u043C\u0435\u0440\u043D\u044B\u0435
      \u043F\u043B\u0430\u0442\u044B, \u0442\u0430\u043A \u0438 \u0443\u043A\u043E\u0440\u043E\u0447\u0435\u043D\u043D\u044B\u0435
      \u043C\u043E\u0434\u0435\u043B\u0438, \u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435
      \u0443\u0437\u043A\u0438\u0435 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B
      \u0441 \u0434\u0432\u0443\u043C\u044F \u0441\u043B\u043E\u0442\u0430\u043C\u0438
      \u043E\u043F\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u043E\u0439 \u043F\u0430\u043C\u044F\u0442\u0438. 
      \u041C\u043E\u0434\u0443\u043B\u044C\u043D\u0430\u044F \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F
      \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0441\u043E\u0431\u0440\u0430\u0442\u044C
      \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0439 \u0441\u0442\u0435\u043D\u0434
      \u0441 \u0443\u0434\u043E\u0431\u043D\u044B\u043C \u0434\u043E\u0441\u0442\u0443\u043F\u043E\u043C
      \u043A \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0443\u044E\u0449\u0438\u043C
      \u0438\u043B\u0438 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u043A\u0430\u0440\u043A\u0430\u0441
      \u0434\u0435\u043A\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u043C\u0438
      \u043F\u0430\u043D\u0435\u043B\u044F\u043C\u0438. \u041F\u0430\u043D\u0435\u043B\u0438
      \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B \u0432 \u0440\u0430\u0437\u043D\u044B\u0445
      \u0446\u0432\u0435\u0442\u0430\u0445 \u0438 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430\u0445
      \u0434\u0438\u0437\u0430\u0439\u043D\u0430, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u0432\u043D\u0435\u0448\u043D\u0438\u0439 \u0432\u0438\u0434 \u043A\u043E\u0440\u043F\u0443\u0441\u0430
      \u043C\u043E\u0436\u043D\u043E \u043C\u0435\u043D\u044F\u0442\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E
      \u043E\u0442 \u0441\u0430\u043C\u043E\u0433\u043E \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430.
      \u0414\u043B\u044F \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0438 \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D
      \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043C\u043E\u0434\u0443\u043B\u044C.  \u0412 \u043A\u043E\u0440\u043F\u0443\u0441\u0435
      \u043C\u043E\u0436\u043D\u043E \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u0443\u044E
      \u0440\u0430\u0431\u043E\u0447\u0443\u044E \u0441\u0442\u0430\u043D\u0446\u0438\u044E
      \u0441\u043E \u0432\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u043E\u0439 \u0433\u0440\u0430\u0444\u0438\u043A\u043E\u0439,
      \u0438\u0433\u0440\u043E\u0432\u043E\u0439 \u041F\u041A \u0441 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
      Low Profile \u0432\u0438\u0434\u0435\u043E\u043A\u0430\u0440\u0442\u043E\u0439
      \u0438\u043B\u0438 \u0434\u043E\u043C\u0430\u0448\u043D\u0438\u0439 NAS. \u0412
      \u0431\u0430\u0437\u043E\u0432\u043E\u0439 \u043A\u043E\u043D\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u0438
      \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u044B
      \u0434\u0432\u0430 \u043C\u0435\u0441\u0442\u0430 \u0434\u043B\u044F SATA SSD.
      \u041A\u043E\u043C\u043F\u043B\u0435\u043A\u0442 \u0437\u0430\u0434\u043D\u0438\u0445
      \u043F\u0430\u043D\u0435\u043B\u0435\u0439 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442
      \u0435\u0449\u0451 \u0434\u0432\u0430 \u043C\u0435\u0441\u0442\u0430 \u2014
      \u0432\u0441\u0435\u0433\u043E \u043C\u043E\u0436\u043D\u043E \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u0447\u0435\u0442\u044B\u0440\u0435 \u043D\u0430\u043A\u043E\u043F\u0438\u0442\u0435\u043B\u044F. 
      \u041E\u0442\u043A\u0440\u044B\u0442\u0430\u044F \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F
      \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0439
      \u0434\u043E\u0441\u0442\u0443\u043F \u0432\u043E\u0437\u0434\u0443\u0445\u0430
      \u043A \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0443\u044E\u0449\u0438\u043C
      \u0438 \u0443\u0434\u043E\u0431\u043D\u044B\u0439 \u0434\u043E\u0441\u0442\u0443\u043F
      \u043F\u0440\u0438 \u0441\u0431\u043E\u0440\u043A\u0435 \u0438 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0438.
      \u041A\u043E\u0440\u043F\u0443\u0441 \u0432\u0435\u0441\u0438\u0442 \u043E\u043A\u043E\u043B\u043E
      400 \u0433.  \u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u0442\u043E\u043B\u044C\u043A\u043E \u0431\u043B\u043E\u043A\u0438 \u043F\u0438\u0442\u0430\u043D\u0438\u044F
      \u0444\u043E\u0440\u043C\u0430\u0442\u0430 TFX. \u041C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F
      \u0432\u044B\u0441\u043E\u0442\u0430 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440\u043D\u043E\u0433\u043E
      \u043A\u0443\u043B\u0435\u0440\u0430 \u2014 70 \u043C\u043C.  \u041F\u0435\u0440\u0435\u0434
      \u0432\u044B\u0431\u043E\u0440\u043E\u043C \u0432\u0438\u0434\u0435\u043E\u043A\u0430\u0440\u0442\u044B
      \u043F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435
      \u0441\u043B\u043E\u0442\u0430 PCIe \u043D\u0430 \u043C\u0430\u0442\u0435\u0440\u0438\u043D\u0441\u043A\u043E\u0439
      \u043F\u043B\u0430\u0442\u0435. \u0415\u0441\u043B\u0438 \u043E\u043D \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u0432 \u0441\u0430\u043C\u043E\u0439 \u0432\u0435\u0440\u0445\u043D\u0435\u0439
      \u043F\u043E\u0437\u0438\u0446\u0438\u0438, \u043D\u0430 \u0443\u0440\u043E\u0432\u043D\u0435
      \u043A\u0440\u0435\u043F\u0451\u0436\u043D\u044B\u0445 \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0439
      \u043F\u043B\u0430\u0442\u044B, \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u0434
      \u0437\u0430\u0434\u043D\u0435\u0439 \u043F\u0430\u043D\u0435\u043B\u044C\u044E
      \u0440\u0430\u0437\u044A\u0451\u043C\u043E\u0432, \u043C\u043E\u0436\u043D\u043E
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043E\u0434\u043D\u043E\u0441\u043B\u043E\u0442\u043E\u0432\u0443\u044E
      \u0438\u043B\u0438 \u0434\u0432\u0443\u0445\u0441\u043B\u043E\u0442\u043E\u0432\u0443\u044E
      \u043D\u0438\u0437\u043A\u043E\u043F\u0440\u043E\u0444\u0438\u043B\u044C\u043D\u0443\u044E
      \u0432\u0438\u0434\u0435\u043E\u043A\u0430\u0440\u0442\u0443. \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
      RTX 3050 LP, RTX 4060 LP, RTX 5060 LP, RX 550 LP \u0438\u043B\u0438 RX 6400
      LP.  \u0415\u0441\u043B\u0438 \u0432\u0435\u0440\u0445\u043D\u044E\u044E \u043F\u043E\u0437\u0438\u0446\u0438\u044E
      \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u0440\u0430\u0437\u044A\u0451\u043C
      M.2, \u0430 \u0441\u043B\u043E\u0442 PCIe \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D
      \u043D\u0438\u0436\u0435, \u043C\u043E\u0436\u043D\u043E \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u043D\u043E\u0441\u043B\u043E\u0442\u043E\u0432\u0443\u044E
      \u043D\u0438\u0437\u043A\u043E\u043F\u0440\u043E\u0444\u0438\u043B\u044C\u043D\u0443\u044E
      \u0432\u0438\u0434\u0435\u043E\u043A\u0430\u0440\u0442\u0443. \u041E\u0431\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435
      Low Profile \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043A \u0432\u044B\u0441\u043E\u0442\u0435
      \u043A\u0430\u0440\u0442\u044B: \u043F\u0435\u0440\u0435\u0434 \u043F\u043E\u043A\u0443\u043F\u043A\u043E\u0439
      \u0442\u0430\u043A\u0436\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435
      \u0442\u043E\u043B\u0449\u0438\u043D\u0443 \u0441\u0438\u0441\u0442\u0435\u043C\u044B
      \u043E\u0445\u043B\u0430\u0436\u0434\u0435\u043D\u0438\u044F \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E\u0439
      \u043C\u043E\u0434\u0435\u043B\u0438.  \u041A\u043E\u043C\u043F\u043B\u0435\u043A\u0442
      \u0434\u0435\u043A\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0445 \u043F\u0430\u043D\u0435\u043B\u0435\u0439
      (\u0430\u0440\u0442\u0438\u043A\u0443\u043B: 6115366382), \u043C\u043E\u0434\u0443\u043B\u044C
      \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0438 (\u0441\u043A\u043E\u0440\u043E
      \u0432 \u043F\u0440\u043E\u0434\u0430\u0436\u0435) \u0438 \u0432\u043D\u0435\u0448\u043D\u044F\u044F
      \u043A\u043D\u043E\u043F\u043A\u0430 \u043F\u0438\u0442\u0430\u043D\u0438\u044F
      \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0430\u044E\u0442\u0441\u044F
      \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E. \u041F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0443\u044E
      \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438
      \u043D\u0430 \u043C\u0430\u0440\u043A\u0435\u0442\u043F\u043B\u0435\u0439\u0441\u0430\u0445
      \u043F\u043E \u0437\u0430\u043F\u0440\u043E\u0441\u0443 \xAB\u0432\u043D\u0435\u0448\u043D\u044F\u044F
      \u043A\u043D\u043E\u043F\u043A\u0430 \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F
      \u041F\u041A\xBB."
  - Id: Frame SFF Panels WH
    Title: "\u041A\u043E\u043C\u043F\u043B\u0435\u043A\u0442 \u0431\u0435\u043B\u044B\u0445
      \u043F\u0430\u043D\u0435\u043B\u0435\u0439 \u0434\u043B\u044F \u043A\u043E\u0440\u043F\u0443\u0441\u0430
      Frame SFF"
    Description: "\u041A\u043E\u043C\u043F\u043B\u0435\u043A\u0442 \u0438\u0437 6
      \u043F\u0430\u043D\u0430\u043B\u0435\u0439 \u0434\u043B\u044F \u043C\u043E\u0434\u0443\u043B\u044C\u043D\u043E\u0433\u043E
      \u043A\u043E\u0440\u043F\u0443\u0441\u0430 Frame SFF. \u0417\u0430\u0434\u043D\u0438\u0435
      \u043F\u0430\u043D\u0435\u043B\u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C 2 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      2.5'' \u043D\u0430\u043A\u043E\u043F\u0438\u0442\u0435\u043B\u044F."
